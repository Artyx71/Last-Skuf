+ completed.start_scene()
+ completed.exit_action.connect(func(_a: Dictionary): exits += 1)
+ completed.skip_seen()
+ check(exits == 1, "disk roundtrip cannot repeat consequence")
+ var opts := root.get_node("OptionsStore")
