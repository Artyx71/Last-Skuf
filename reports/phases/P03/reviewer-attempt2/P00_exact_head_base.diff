diff --git a/game/export_presets.cfg b/game/export_presets.cfg
new file mode 100644
index 0000000..cc9b00e
--- /dev/null
+++ b/game/export_presets.cfg
@@ -0,0 +1,33 @@
+[preset.0]
+name="Linux"
+platform="Linux"
+runnable=true
+export_filter="all_resources"
+include_filter="LICENSES/*.txt"
+exclude_filter="tests/*"
+export_path="../build/linux/last-skuf.x86_64"
+
+[preset.0.options]
+custom_template/debug=""
+custom_template/release="../.tools/godot/templates/linux_release.x86_64"
+binary_format/architecture="x86_64"
+binary_format/embed_pck=true
+texture_format/s3tc_bptc=true
+
+[preset.1]
+name="Windows"
+platform="Windows Desktop"
+runnable=false
+export_filter="all_resources"
+include_filter="LICENSES/*.txt"
+exclude_filter="tests/*"
+export_path="../build/windows/last-skuf.exe"
+
+[preset.1.options]
+custom_template/debug=""
+custom_template/release="../.tools/godot/templates/windows_release_x86_64.exe"
+binary_format/architecture="x86_64"
+binary_format/embed_pck=true
+texture_format/s3tc_bptc=true
+codesign/enable=false
+application/modify_resources=false
