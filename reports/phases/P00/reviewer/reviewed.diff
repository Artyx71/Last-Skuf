+[preset.0]
+name="Linux"
+platform="Linux"
+runnable=true
+export_filter="all_resources"
+include_filter="LICENSES/*.txt"
+exclude_filter="tests/*"
+export_path="../build/linux/last-skuf.x86_64"
+
+[preset.0.options]
+custom_template/debug=""
+custom_template/release="../.tools/godot/templates/linux_release.x86_64"
+binary_format/architecture="x86_64"
+binary_format/embed_pck=true
+texture_format/s3tc_bptc=true
+
+[preset.1]
+name="Windows"
+platform="Windows Desktop"
+runnable=false
+export_filter="all_resources"
+include_filter="LICENSES/*.txt"
+exclude_filter="tests/*"
+export_path="../build/windows/last-skuf.exe"
+
+[preset.1.options]
+custom_template/debug=""
+custom_template/release="../.tools/godot/templates/windows_release_x86_64.exe"
+binary_format/architecture="x86_64"
+binary_format/embed_pck=true
+texture_format/s3tc_bptc=true
+codesign/enable=false
+application/modify_resources=false
diff --git a/game/project.godot b/game/project.godot
new file mode 100644
index 0000000..eebbb58
--- /dev/null
+++ b/game/project.godot
@@ -0,0 +1,22 @@
+; Native Godot project. P00 infrastructure only.
+config_version=5
+
+[application]
+config/name="АЫАЫ: Последний скуф"
+run/main_scene="res://scenes/bootstrap/bootstrap.tscn"
+config/features=PackedStringArray("4.7", "GL Compatibility")
+
+[display]
+window/size/viewport_width=640
+window/size/viewport_height=360
+window/size/window_width_override=1280
+window/size/window_height_override=720
+window/stretch/mode="canvas_items"
+window/stretch/scale_mode="integer"
+
+[rendering]
+renderer/rendering_method="gl_compatibility"
+renderer/rendering_method.mobile="gl_compatibility"
+textures/default_filters/use_nearest_mipmap_filter=false
+textures/canvas_textures/default_texture_filter=0
+environment/defaults/default_clear_color=Color(0.035, 0.035, 0.06, 1)
