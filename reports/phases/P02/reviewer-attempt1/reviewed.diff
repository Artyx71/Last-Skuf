+		passed += 1
+		print("PASS ", title)
+	else:
+		failed += 1
+		push_error("FAIL " + title)
+
+
+func _frames(count: int) -> void:
+	for index in count:
+		await physics_frame
+
+
+func _fixture(index: int) -> CharacterBody2D:
+	lab.reset_encounter()
+	lab.auto_retry = false
+	lab.player.set_physics_process(false)
