      "after_line_range": [
        18,
        22
      ],
      "inserted_text": "var focus_events: Array[Dictionary] = []\nvar movie_window_no_focus_requested := false\n\nfunc note_focus(focused: bool) -> void:\n focus_events.append({\"focused\":focused,\"physics_tick\":Engine.get_physics_frames(),\"wall_usec\":Time.get_ticks_usec(),\"sequence\":sequence})\n",
      "removed_text": ""
    },
    {
      "tag": "insert",
      "before_line_range": [
        68,
        67
      ],
      "after_line_range": [
        73,
        76
      ],
      "inserted_text": " var actual_input := Input.get_vector(\"move_left\",\"move_right\",\"move_up\",\"move_down\")\n at[\"input_vector\"] = [actual_input.x,actual_input.y]\n at[\"run_pressed\"] = Input.is_action_pressed(\"p06_preview_run\")\n at[\"window_focused\"] = root.call(\"has_focus\") if root.has_method(\"has_focus\") else null\n",
      "removed_text": ""
    },
    {
      "tag": "insert",
      "before_line_range": [
        80,
        79
      ],
      "after_line_range": [
        89,
        96
      ],
      "inserted_text": " if not headless and not capture_images:\n  # MovieMaker is an automated engine-Input replay, not a manual keyboard test.\n  # Keep its rendering window out of desktop focus changes; losing focus can\n  # otherwise release a scripted held key midway through a recorded segment.\n  root.set_flag(Window.FLAG_NO_FOCUS,true)\n  movie_window_no_focus_requested = true\n if root.has_signal(\"focus_entered\"): root.connect(\"focus_entered\",func():note_focus(true))\n if root.has_signal(\"focus_exited\"): root.connect(\"focus_exited\",func():note_focus(false))\n",
      "removed_text": ""
    },
    {
      "tag": "insert",
      "before_line_range": [
        166,
        165
      ],
      "after_line_range": [
        183,
        185
      ],
      "inserted_text": " result[\"focus_events\"] = focus_events\n result[\"focus_observation\"] = \"Window focus signals and actual movement/run input sampled; no input reassertion or timing changes\"\n result[\"movie_window_no_focus_requested\"] = movie_window_no_focus_requested\n",
      "removed_text": ""
    }
  ],
