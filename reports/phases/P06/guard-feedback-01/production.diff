+
+	var parity := true
+	var bounds := true
+	var layout := true
+	var bar_clear := true
+	var phases: Dictionary = {}
+	for item in observations:
+		if item.displayed != item.model: parity = false
+		if item.phase=="guard" and not item.window_open: parity = false
+		if item.bar < 0 or item.bar > 1: bounds = false
