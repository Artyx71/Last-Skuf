; Native Godot project. P00 infrastructure only.
config_version=5

[application]
config/name="АЫАЫ: Последний скуф"
run/main_scene="res://scenes/bootstrap/bootstrap.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
OptionsStore="*res://scripts/core/options_store.gd"
AudioDirector="*res://scripts/systems/audio_director.gd"
DialogueDirector="*res://scripts/systems/dialogue_director.gd"

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.035, 0.035, 0.06, 1)
